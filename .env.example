# LinkedIn Automation Tool - Environment Configuration

# Required: LinkedIn Credentials
# Use your actual LinkedIn login credentials
LINKEDIN_EMAIL=your-linkedin-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password

# Required: OpenAI API Key
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Optional: Debug Settings
# NODE_ENV=development
# DEBUG=puppeteer:*

# Security Notes:
# 1. Never commit this file to version control
# 2. Keep your credentials secure and private
# 3. Rotate your API keys regularly
# 4. Use environment-specific configurations for different deployments